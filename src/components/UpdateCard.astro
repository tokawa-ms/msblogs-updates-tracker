---
import { formatDate, getUpdateSlug } from '../lib/content';
import { withBase } from '../lib/site';
import LocalizedText from './LocalizedText.astro';
import type { UpdateEntry } from '../lib/content';

interface Props {
  entry: UpdateEntry;
}

const { entry } = Astro.props;
const updateSlug = getUpdateSlug(entry);
---

<article class="card">
  <div class="card-header">
    <p class="eyebrow"><LocalizedText ja="日次更新" en="Daily update" /></p>
    <h3>
      <a href={withBase(`updates/${updateSlug}/`)}>
        <LocalizedText ja={entry.data.title} en={entry.data.titleEn} />
      </a>
    </h3>
  </div>
  <LocalizedText as="p" ja={entry.data.description} en={entry.data.descriptionEn} />
  <dl class="stats-inline">
    <div>
      <dt>日付</dt>
      <dd>{formatDate(entry.data.date)}</dd>
    </div>
    <div>
      <dt>新規記事</dt>
      <dd>{entry.data.newCount}</dd>
    </div>
    <div>
      <dt>ソース</dt>
      <dd>{entry.data.sourceCount}</dd>
    </div>
  </dl>
</article>
