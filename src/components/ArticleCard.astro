---
import CategoryPill from './CategoryPill.astro';
import LocalizedText from './LocalizedText.astro';
import { formatDate, slugify, type ArticleWithMeta } from '../lib/content';
import { withBase } from '../lib/site';

interface Props {
  article: ArticleWithMeta;
}

const { article } = Astro.props;
---

<article class="card article-card">
  <div class="card-header">
    <p class="eyebrow">{article.sourceName}</p>
    <h3>
      <a href={article.url} target="_blank" rel="noreferrer">{article.title}</a>
    </h3>
  </div>
  <LocalizedText as="p" ja={article.summary} en={article.summaryEn?.trim() || 'English summary is not available for this article yet.'} />
  {article.significance && (
    <p data-lang="ja"><strong>なぜ重要か: </strong>{article.significance}</p>
  )}
  {article.significanceEn?.trim() && (
    <p data-lang="en"><strong>Why it matters: </strong>{article.significanceEn}</p>
  )}
  {article.keyPoints.length > 0 && (
    <div data-lang="ja">
      <strong>重要ポイント</strong>
      <ul>
        {article.keyPoints.map((point) => <li>{point}</li>)}
      </ul>
    </div>
  )}
  {article.keyPointsEn?.some((point) => point.trim()) && (
    <div data-lang="en">
      <strong>Key points</strong>
      <ul>
        {article.keyPointsEn.filter((point) => point.trim()).map((point) => <li>{point}</li>)}
      </ul>
    </div>
  )}
  <div class="pill-row">
    {article.categories.map((category) => (
      <CategoryPill name={category} href={withBase(`categories/${slugify(category)}/`)} />
    ))}
    <span class="pill importance">{article.importance.badge}</span>
  </div>
  <dl class="stats-inline compact">
    <div>
      <dt>掲載日</dt>
      <dd>{formatDate(article.updateDate)}</dd>
    </div>
    <div>
      <dt>公開日時</dt>
      <dd>{formatDate(article.publishedAt)}</dd>
    </div>
  </dl>
</article>
