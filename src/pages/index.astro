---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LocalizedText from '../components/LocalizedText.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { getCategoryCounts, getPublishedUpdates, getRecentArticles } from '../lib/content';
import { withBase } from '../lib/site';

const updates = await getPublishedUpdates();
const latestUpdates = updates.slice(0, 7);
const recentArticles = getRecentArticles(updates, 9);
const categoryCounts = getCategoryCounts(updates);
const totalArticles = updates.reduce((count, entry) => count + entry.data.newCount, 0);
---

<BaseLayout
  title="MS Blogs Update Tracker"
  description="Microsoft と GitHub の主要ブログ更新を日次で確認できる Astro サイトです。"
>
  <section class="hero">
    <p class="eyebrow"><LocalizedText ja="日次更新トラッカー" en="Daily update tracker" /></p>
    <LocalizedText as="h1" ja="Microsoft ブログ更新を 1 画面で追跡" en="Track Microsoft blog updates in one place" />
    <LocalizedText
      as="p"
      class="hero-copy"
      ja="GitHub、VSCode、Azure、Microsoft 365、Fabric、AI Blog の日次差分を日本語で整理し、英語版にも切り替えられるサイトとして公開しています。"
      en="Daily updates from GitHub, VSCode, Azure, Microsoft 365, Fabric, and AI blogs are organized with a Japanese primary view and an English switch."
    />
    <div class="hero-grid">
      <article class="metric-card">
        <span><LocalizedText ja="更新日数" en="Update days" /></span>
        <strong>{updates.length}</strong>
      </article>
      <article class="metric-card">
        <span><LocalizedText ja="新規記事数" en="New articles" /></span>
        <strong>{totalArticles}</strong>
      </article>
      <article class="metric-card">
        <span><LocalizedText ja="カテゴリ" en="Categories" /></span>
        <strong>{categoryCounts.filter((category) => category.count > 0).length}</strong>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2><LocalizedText ja="最新の更新日" en="Latest updates" /></h2>
      <a href={withBase('updates/')}><LocalizedText ja="すべて見る" en="View all" /></a>
    </div>
    {
      latestUpdates.length > 0 ? (
        <div class="grid two-column">
          {latestUpdates.map((entry) => (
            <UpdateCard entry={entry} />
          ))}
        </div>
      ) : (
        <div class="card empty-state">
          <h3><LocalizedText ja="更新データはまだありません" en="No update data yet" /></h3>
          <p>
            <LocalizedText
              ja="`npm run fetch` → `npm run diff` → `npm run generate` の順で実行すると一覧に反映されます。"
              en="Run `npm run fetch`, `npm run diff`, and `npm run generate` to populate this list."
            />
          </p>
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="section-heading">
      <h2><LocalizedText ja="注目カテゴリ" en="Featured categories" /></h2>
      <a href={withBase('categories/')}><LocalizedText ja="カテゴリ一覧" en="All categories" /></a>
    </div>
    <div class="grid three-column">
      {categoryCounts.map((category) => (
        <article class="card">
          <p class="eyebrow"><LocalizedText ja={`${category.count} 件の記事`} en={`${category.count} articles`} /></p>
          <h3>
            {category.count > 0 ? (
              <a href={withBase(`categories/${category.slug}/`)}>{category.name}</a>
            ) : (
              category.name
            )}
          </h3>
          <p>{category.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2><LocalizedText ja="最新記事" en="Latest articles" /></h2>
      <a href={withBase('updates/')}><LocalizedText ja="更新日別に見る" en="Browse by update date" /></a>
    </div>
    {
      recentArticles.length > 0 ? (
        <div class="grid three-column">
          {recentArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : null
    }
  </section>
</BaseLayout>
