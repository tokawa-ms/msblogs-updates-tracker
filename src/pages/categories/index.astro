---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryCounts, getPublishedUpdates } from '../../lib/content';

const updates = await getPublishedUpdates();
const categoryCounts = getCategoryCounts(updates);
---

<BaseLayout
  title="Categories | MS Blogs Update Tracker"
  description="カテゴリ別に Microsoft ブログ更新を確認できます。"
>
  <section class="page-header">
    <p class="eyebrow">Categories</p>
    <h1>カテゴリ一覧</h1>
    <p>記事タイトルと概要から推定したカテゴリで横断的に追跡できます。</p>
  </section>

  <div class="grid three-column">
    {categoryCounts.map((category) => (
      <article class="card">
        <p class="eyebrow">{category.count} articles</p>
        <h2>
          {category.count > 0 ? <a href={`/categories/${category.slug}/`}>{category.name}</a> : category.name}
        </h2>
        <p>{category.description}</p>
      </article>
    ))}
  </div>
</BaseLayout>
