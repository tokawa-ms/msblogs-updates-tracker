---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import {
  formatDate,
  formatDateTime,
  getGroupedArticles,
  getPublishedUpdates,
  getUpdateSlug,
  type UpdateEntry,
} from '../../lib/content';

export async function getStaticPaths() {
  const updates = await getPublishedUpdates();
  return updates.map((entry) => ({
    params: { slug: getUpdateSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: UpdateEntry };
const groupedArticles = getGroupedArticles(entry);
---

<BaseLayout title={`${entry.data.title} | MS Blogs Update Tracker`} description={entry.data.description}>
  <section class="page-header">
    <p class="eyebrow"><LocalizedText ja="日次更新詳細" en="Daily update detail" /></p>
    <LocalizedText as="h1" ja={entry.data.title} en={entry.data.titleEn} />
    <LocalizedText as="p" ja={entry.data.description} en={entry.data.descriptionEn} />
  </section>

  <section class="section">
    <div class="grid three-column">
      <article class="metric-card">
        <span><LocalizedText ja="対象日" en="Date" /></span>
        <strong>{formatDate(entry.data.date)}</strong>
      </article>
      <article class="metric-card">
        <span><LocalizedText ja="新規記事" en="New articles" /></span>
        <strong>{entry.data.newCount}</strong>
      </article>
      <article class="metric-card">
        <span><LocalizedText ja="最終生成" en="Last generated" /></span>
        <strong>{formatDateTime(entry.data.lastUpdated)}</strong>
      </article>
    </div>
  </section>

  <section class="section prose-card">
    <h2><LocalizedText ja="サマリー" en="Summary" /></h2>
    <ul>
      <li><LocalizedText ja={`比較対象: ${entry.data.comparedWith || '不明'}`} en={`Compared with: ${entry.data.comparedWith || 'unknown'}`} /></li>
      <li><LocalizedText ja={`ソース数: ${entry.data.sourceCount}`} en={`Source count: ${entry.data.sourceCount}`} /></li>
      <li><LocalizedText ja={`削除記事: ${entry.data.removedCount}`} en={`Removed articles: ${entry.data.removedCount}`} /></li>
    </ul>
  </section>

  {
    groupedArticles.map((group) => (
      <section class="section">
        <div class="section-heading">
          <h2>{group.sourceName}</h2>
          <span>
            <LocalizedText ja={`${group.articles.length} 件の記事`} en={`${group.articles.length} articles`} />
          </span>
        </div>
        <div class="grid two-column">
          {group.articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
